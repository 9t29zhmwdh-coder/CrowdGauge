# CrowdGauge configuration
# Copy to .env and fill in the providers you actually have keys for.
# CrowdGauge runs without any key at all, on Swiss open data.

# Which provider to use: opendata | serpapi | besttime | demo
# "auto" picks the first provider whose credentials are present. Without any key
# that is opendata, which needs no account, with demo as the last resort.
CROWDGAUGE_PROVIDER=auto

# opendata needs no configuration at all: Swiss cities publish their
# pedestrian counter readings openly. Covered so far: Basel.

# SerpApi: relays Google Maps popular times including a live busyness value.
# Free tier at the time of writing: 250 searches per month. https://serpapi.com/
CROWDGAUGE_SERPAPI_KEY=

# BestTime.app: independent footfall forecasts from anonymised phone signals.
# Needs both keys, the private one creates forecasts, the public one queries them.
# https://besttime.app/
CROWDGAUGE_BESTTIME_PRIVATE_KEY=
CROWDGAUGE_BESTTIME_PUBLIC_KEY=

# Server binding for the local web app
CROWDGAUGE_HOST=127.0.0.1
CROWDGAUGE_PORT=8734

# Seconds a provider response stays in the in-memory cache.
# Live values are always fetched fresh and bypass this cache.
CROWDGAUGE_CACHE_TTL=900
